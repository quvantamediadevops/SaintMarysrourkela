# ── Build-time (public) ──────────────────────────────────────────────────────
# Live URL of the site. Used for canonical URLs, sitemap, robots, Open Graph
# and structured data. REQUIRED on Cloudflare builds (the build fails without it).
NEXT_PUBLIC_SITE_URL=https://www.your-school-domain.in

# ── Runtime secret (Cloudflare Worker) ───────────────────────────────────────
# Do NOT put this in .env or any NEXT_PUBLIC_ variable. Set it as a secret:
#   npx wrangler secret put ENQUIRY_WEBHOOK_URL
# or in the Cloudflare dashboard → Worker → Settings → Variables and Secrets (type: Secret).
# For local `npm run preview`, put it in .dev.vars (git-ignored):
#   ENQUIRY_WEBHOOK_URL=https://script.google.com/macros/s/…/exec
